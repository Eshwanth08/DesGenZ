# DesGenZ configuration — copy to .env.local and fill in.
# Everything is optional; the app degrades gracefully per missing group.

# ---- Supabase (client database; enables cloud mode for the data layer) ----
# Dashboard → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=   # server-side ONLY — bypasses RLS, never expose to the client
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ---- Gemini (AI extraction/scoring; heuristic engine used when absent) ----
GEMINI_API_KEY=

# ---- Figma MCP (Stage 6 push; in-app viewer used when absent) ----
FIGMA_MCP_ENDPOINT=
FIGMA_MCP_TOKEN=

# ---- Session signing secret (falls back to a dev default) ----
DESGENZ_SECRET=
